	local keyBtn = new("TextButton", {
		Size = UDim2.fromOffset(116, 30),
		Position = UDim2.new(1, -128, 0.5, -15),
		BackgroundColor3 = T.Panel,
		Text = settings.toggleKey,
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = T.Text,
		Parent = kr,
	})
	corner(keyBtn, 8)
	local kst = stroke(keyBtn, T.Stroke)
	animate(keyBtn, T.Panel)
	local listening = false
	keyBtn.MouseButton1Click:Connect(function()
		if listening then
			return
		end
		listening = true
		keyBtn.Text = "Press a key..."
		tween(kst, 0.2, { Color = T.Accent })
		local c
		c = UIS.InputBegan:Connect(function(i)
			if i.UserInputType ~= Enum.UserInputType.Keyboard then

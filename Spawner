		ScrollBarImageColor3 = T.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		LayoutOrder = 5,
		Parent = page,
	})
	corner(listFrame, 10)
	stroke(listFrame, T.Stroke)
	list(listFrame, 3)
	padding(listFrame, 5, 5, 5, 5)

	local rows = {}
	local function rowBase(name)
		return sel.animal == name and T.CardHover or T.Card
	end
	for i, a in ipairs(animalList) do
		local r = new("TextButton", {
			Size = UDim2.new(1, 0, 0, px(36)),
			BackgroundColor3 = T.Card,
			Text = "",
			LayoutOrder = i,
			Parent = listFrame,
		})
		corner(r, 8)
		local rs = stroke(r, T.Accent, 1.5, 1)
		new("Frame", {
			Size = UDim2.new(0, 3, 0, 18),
			Position = UDim2.new(0, 8, 0.5, -9),
			BackgroundColor3 = rarityColor(a.rarity),
			BorderSizePixel = 0,
			Parent = r,
		}, { new("UICorner", { CornerRadius = UDim.new(0, 2) }) })
		new("TextLabel", {
			Size = UDim2.new(1, -110, 1, 0),
			Position = UDim2.fromOffset(18, 0),
			BackgroundTransparency = 1,
			Text = a.name,
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextColor3 = T.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = r,
		})
		new("TextLabel", {
			Size = UDim2.new(0, 84, 1, 0),
			Position = UDim2.new(1, -92, 0, 0),
			BackgroundTransparency = 1,
			Text = a.gen > 0 and ("$" .. fmt(a.gen) .. "/s") or a.rarity,
			Font = Enum.Font.GothamMedium,
			TextSize = 11,
			TextColor3 = a.gen > 0 and T.Good or T.Sub,
			TextXAlignment = Enum.TextXAlignment.Right,
			Parent = r,
		})
		animate(r, function()
			return rowBase(a.name)
		end)
		rows[a.name] = { btn = r, stroke = rs, data = a }
		r.MouseButton1Click:Connect(function()
			local prev = sel.animal
			sel.animal = a.name
			if prev and rows[prev] then
				tween(rows[prev].btn, 0.2, { BackgroundColor3 = T.Card })
				tween(rows[prev].stroke, 0.2, { Transparency = 1 })
			end
			tween(r, 0.2, { BackgroundColor3 = T.CardHover })
			tween(rs, 0.2, { Transparency = 0 })
			refreshCard()
			queuePreview()
		end)
	end

	local emptyLbl = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 60),
		BackgroundTransparency = 1,
		Text = "No brainrots match",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = T.Sub,
		Visible = false,
		LayoutOrder = 0,
		Parent = listFrame,
	})

	local function matches(name, q)
		local lname = name:lower()
		for word in q:gmatch("%S+") do
			if not lname:find(word, 1, true) then
				return false
			end
		end
		return true
	end
	local function applyFilter()
		local q = search.Text:lower()
		local n = 0
		for _, row in pairs(rows) do
			local okR = sel.rarity == "All" or row.data.rarity == sel.rarity
			local show = okR and matches(row.data.name, q)
			row.btn.Visible = show
			if show then
				n += 1
			end
		end
		emptyLbl.Visible = n == 0
		setAnimalCount(n)
		listFrame.CanvasPosition = Vector2.zero
	end
	local filterToken = 0
	search:GetPropertyChangedSignal("Text"):Connect(function()
		filterToken += 1
		local my = filterToken
		task.delay(0.08, function()
			if my == filterToken then
				applyFilter()
			end
		end)
	end)

	local rarRefreshers = {}
	for _, r in ipairs(rarities) do
		local b, refresh = chip(rarScroll, r, r == "All" and T.Text or rarityColor(r), function()
			return sel.rarity == r
		end)
		table.insert(rarRefreshers, refresh)
		b.MouseButton1Click:Connect(function()
			sel.rarity = r
			for _, f in ipairs(rarRefreshers) do
				f()
			end
			applyFilter()
		end)
		refresh()
	end

	sectionLabel(page, "Mutation", 6)
	local mutScroll = chipScroller(page, 30, 7)
	local mutRefreshers = {}
	for _, m in ipairs(mutationList) do
		local b, refresh = chip(mutScroll, m == "None" and "Normal" or m, m == "None" and T.Text or mutationColor(m), function()
			return sel.mutation == m
		end)
		table.insert(mutRefreshers, refresh)
		b.MouseButton1Click:Connect(function()
			sel.mutation = m
			for _, f in ipairs(mutRefreshers) do
				f()
			end
			refreshCard()
			queuePreview()
		end)
		refresh()
	end

	local traitHeader = new("Frame", {
		Size = UDim2.new(1, 0, 0, 16),
		BackgroundTransparency = 1,
		LayoutOrder = 8,
		Parent = page,
	})
	local traitTitle = sectionLabel(traitHeader, "Traits", 0)
	local clearTraits = new("TextButton", {
		Size = UDim2.fromOffset(60, 16),
		Position = UDim2.new(1, -60, 0, 0),
		BackgroundTransparency = 1,
		Text = "CLEAR",
		Font = Enum.Font.GothamBold,
		TextSize = 10,
		TextColor3 = T.Accent2,
		TextXAlignment = Enum.TextXAlignment.Right,
		Parent = traitHeader,
	})
	local traitSearch, setTraitCount = searchBox(page, "Search traits...", 9)
	local traitGrid = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, px(110)),
		BackgroundColor3 = T.Panel,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = T.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		LayoutOrder = 10,
		Parent = page,
	})
	corner(traitGrid, 10)
	stroke(traitGrid, T.Stroke)
	padding(traitGrid, 6, 6, 6, 6)
	new("UIGridLayout", {
		CellSize = UDim2.new(0.5, -4, 0, px(32)),
		CellPadding = UDim2.fromOffset(6, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = traitGrid,
	})
	local traitRefreshers = {}
	local traitButtons = {}
	local function updateTraitTitle()
		local n = #selectedTraits()
		traitTitle.Text = n > 0 and ("TRAITS  •  " .. n .. " SELECTED") or "TRAITS"
	end
	for i, t in ipairs(traitList) do
		local b = new("TextButton", {
			BackgroundColor3 = T.Card,
			Text = "",
			LayoutOrder = i,
			Parent = traitGrid,
		})
		corner(b, 8)
		local st = stroke(b, T.Stroke)
		local ic = traitIcon(t)
		if ic then
			new("ImageLabel", {
				Size = UDim2.fromOffset(20, 20),
				Position = UDim2.new(0, 6, 0.5, -10),
				BackgroundTransparency = 1,
				Image = ic,
				Parent = b,
			})
		end
		new("TextLabel", {
			Size = UDim2.new(1, -34, 1, 0),
			Position = UDim2.fromOffset(30, 0),
			BackgroundTransparency = 1,
			Text = t,
			Font = Enum.Font.GothamBold,
			TextSize = 11,
			TextColor3 = T.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = b,
		})
		local function base()
			return sel.traits[t] and T.CardHover or T.Card
		end
		animate(b, base)
		local function refresh()
			tween(b, 0.2, { BackgroundColor3 = base() })
			tween(st, 0.2, { Color = sel.traits[t] and T.Accent or T.Stroke })
		end
		table.insert(traitRefreshers, refresh)
		traitButtons[t] = b
		b.MouseButton1Click:Connect(function()
			sel.traits[t] = not sel.traits[t] or nil
			refresh()
			updateTraitTitle()
			refreshCard()
			queuePreview()
		end)
	end
	clearTraits.MouseButton1Click:Connect(function()
		sel.traits = {}
		for _, f in ipairs(traitRefreshers) do
			f()
		end
		updateTraitTitle()
		refreshCard()
		queuePreview()
	end)

	local function filterTraits()
		local q = traitSearch.Text:lower()
		local n = 0
		for name, b in pairs(traitButtons) do
			local show = q == "" or name:lower():find(q, 1, true) ~= nil
			b.Visible = show
			if show then
				n += 1
			end
		end
		setTraitCount(n)
		traitGrid.CanvasPosition = Vector2.zero
	end
	traitSearch:GetPropertyChangedSignal("Text"):Connect(filterTraits)
	filterTraits()

	local row = new("Frame", {
		Size = UDim2.new(1, 0, 0, px(44)),
		BackgroundTransparency = 1,
		LayoutOrder = 12,
		Parent = page,
	})
	local stepper = new("Frame", {
		Size = UDim2.new(0, px(116), 1, 0),
		BackgroundColor3 = T.Card,
		Parent = row,
	})
	corner(stepper, 10)
	stroke(stepper, T.Stroke)
	local qtyLbl = new("TextLabel", {
		Size = UDim2.new(1, -72, 1, 0),
		Position = UDim2.fromOffset(36, 0),
		BackgroundTransparency = 1,
		Text = "x1",
		Font = Enum.Font.GothamBlack,
		TextSize = 15,
		TextColor3 = T.Text,
		Parent = stepper,
	})
	local function stepBtn(text, x, delta)
		local b = new("TextButton", {
			Size = UDim2.fromOffset(px(30), px(30)),
			Position = UDim2.new(x, x == 0 and 6 or -(px(30) + 6), 0.5, -px(30) / 2),
			BackgroundColor3 = T.Panel,
			Text = text,
			Font = Enum.Font.GothamBold,
			TextSize = 18,
			TextColor3 = T.Text,
			Parent = stepper,
		})
		corner(b, 8)
		animate(b, T.Panel, T.Accent)
		b.MouseButton1Click:Connect(function()
			sel.qty = math.clamp(sel.qty + delta, 1, 10)
			qtyLbl.Text = "x" .. sel.qty
			local s = qtyLbl:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = qtyLbl })
			s.Scale = 1.25
			tween(s, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
		end)
	end
	stepBtn("–", 0, -1)
	stepBtn("+", 1, 1)

	local spawnBtn = new("TextButton", {
		Size = UDim2.new(1, -(px(116) + 8), 1, 0),
		Position = UDim2.fromOffset(px(116) + 8, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		Text = "SPAWN",
		Font = Enum.Font.GothamBlack,
		TextSize = 15,
		TextColor3 = Color3.new(1, 1, 1),
		Parent = row,
	})
	corner(spawnBtn, 10)
	local spawnGrad = accentGradient(spawnBtn, 0)
	animate(spawnBtn, Color3.new(1, 1, 1), Color3.fromRGB(220, 220, 255))
	task.spawn(function()
		local t = 0
		while alive() and spawnGrad.Parent do
			t += task.wait()
			spawnGrad.Offset = Vector2.new(math.sin(t * 1.5) * 0.3, 0)
		end
	end)

	spawnBtn.MouseButton1Click:Connect(function()
		if not sel.animal then
			notify("Pick a brainrot first", T.Warn)
			return
		end
		local made, lastErr = 0, nil
		for _ = 1, sel.qty do
			local ok, err = spawnVisual(sel.animal, sel.mutation, selectedTraits())
			if ok then
				made += 1
			else
				lastErr = err
				break
			end
		end
		if made > 0 then
			notify(("Spawned %dx %s"):format(made, sel.animal), T.Good)
		else
			notify(lastErr or "Spawn failed", T.Bad)
		end
	end)

	local clearBtn = bigButton(page, "CLEAR ALL SPAWNED", Color3.fromRGB(70, 28, 40), 13, px(36))
	clearBtn.TextSize = 12
	clearBtn.MouseButton1Click:Connect(function()
		local n = #entries
		clearAll()
		notify(("Cleared %d visual%s"):format(n, n == 1 and "" or "s"), T.Warn)
	end)

	updateTraitTitle()
	applyFilter()
end

do
	local page = pages.Base
	local selected = nil
	sectionLabel(page, "Base skins found in this server", 1)
	local skinList = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 0, 200),
		BackgroundColor3 = T.Panel,
		BorderSizePixel = 0,
		ScrollBarThickness = 3,
		ScrollBarImageColor3 = T.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		LayoutOrder = 2,
		Parent = page,
	})
	corner(skinList, 10)
	stroke(skinList, T.Stroke)
	list(skinList, 3)
	padding(skinList, 5, 5, 5, 5)

	local currentLbl = new("TextLabel", {
		Size = UDim2.new(1, 0, 0, 18),
		BackgroundTransparency = 1,
		Text = "Active: none",
		Font = Enum.Font.GothamMedium,
		TextSize = 12,
		TextColor3 = T.Sub,
		TextXAlignment = Enum.TextXAlignment.Left,
		LayoutOrder = 3,
		Parent = page,
	})

	local rowsB = {}
	local function rebuild()
		for _, r in ipairs(rowsB) do
			r:Destroy()
		end
		rowsB = {}
		local names = findSkins()
		if #names == 0 then
			local l = new("TextLabel", {
				Size = UDim2.new(1, 0, 0, 40),
				BackgroundTransparency = 1,
				Text = Skin.packLoading and "Loading base pack..."
					or (Skin.packError and ("Couldn't load base pack: " .. Skin.packError) or "No base skins found."),
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = T.Sub,
				TextWrapped = true,
				Parent = skinList,
			})
			table.insert(rowsB, l)
			return
		end
		for i, n in ipairs(names) do
			local swatchColor = T.Sub
			for key, c in pairs(Skin.COLORS) do
				if n:lower():find(key:lower(), 1, true) then
					swatchColor = c
				end
			end
			local r = new("TextButton", {
				Size = UDim2.new(1, 0, 0, px(38)),
				BackgroundColor3 = T.Card,
				Text = "",
				LayoutOrder = i,
				Parent = skinList,
			})
			local sw = new("Frame", {
				Size = UDim2.fromOffset(px(22), px(22)),
				Position = UDim2.new(0, 10, 0.5, -px(22) / 2),
				BackgroundColor3 = swatchColor,
				Parent = r,
			})
			corner(sw, 6)
			stroke(sw, Color3.new(1, 1, 1), 1, 0.7)
			new("TextLabel", {
				Size = UDim2.new(1, -110, 1, 0),
				Position = UDim2.fromOffset(px(22) + 20, 0),
				BackgroundTransparency = 1,
				Text = n,
				Font = Enum.Font.GothamBold,
				TextSize = 13,
				TextColor3 = T.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				Parent = r,
			})
			if Skin.name == n then
				new("TextLabel", {
					Size = UDim2.fromOffset(70, 20),
					Position = UDim2.new(1, -80, 0.5, -10),
					BackgroundColor3 = T.Good,
					Text = "ACTIVE",
					Font = Enum.Font.GothamBlack,
					TextSize = 10,
					TextColor3 = Color3.new(1, 1, 1),
					Parent = r,
				}, { new("UICorner", { CornerRadius = UDim.new(0, 10) }) })
			end
			corner(r, 8)
			local st = stroke(r, T.Accent, 1.5, selected == n and 0 or 1)
			animate(r, function()
				return selected == n and T.CardHover or T.Card
			end)
			r.MouseButton1Click:Connect(function()
				selected = n
				for _, other in ipairs(rowsB) do
					local s = other:FindFirstChildOfClass("UIStroke")
					if s then
						tween(s, 0.2, { Transparency = other == r and 0 or 1 })
					end
					if other:IsA("TextButton") then
						tween(other, 0.2, { BackgroundColor3 = other == r and T.CardHover or T.Card })
					end
				end
				tween(st, 0.2, { Transparency = 0 })
			end)
			table.insert(rowsB, r)
		end
	end

	local applyBtn = bigButton(page, "APPLY SKIN", T.Accent, 4)
	accentGradient(applyBtn, 0)
	local removeBtn = bigButton(page, "REMOVE SKIN", Color3.fromRGB(70, 28, 40), 5, 34)
	removeBtn.TextSize = 12
	local refreshBtn = bigButton(page, "REFRESH LIST", T.Card, 6, 30)
	refreshBtn.TextSize = 11

	applyBtn.MouseButton1Click:Connect(function()
		if not selected then
			notify("Select a skin first", T.Warn)
			return
		end
		local ok, err = applySkin(selected)
		autoSkinFor = nil
		if ok then
			currentLbl.Text = "Active: " .. selected
			notify("Base skin: " .. selected, T.Good)
			rebuild()
			scheduleSave()
		else
			notify(err, T.Bad)
		end
	end)
	removeBtn.MouseButton1Click:Connect(function()
		clearSkin()
		autoSkinFor = nil
		currentLbl.Text = "Active: none"
		notify("Base skin removed", T.Warn)
		rebuild()
		scheduleSave()
	end)
	refreshBtn.MouseButton1Click:Connect(function()
		rebuild()
		notify("Skin list refreshed", T.Accent2)
	end)

	tabButtons.Base.MouseButton1Click:Connect(function()
		rebuild()
		if not Skin.pack and not Skin.packLoading then
			task.spawn(function()
				Skin.loadPack()
				rebuild()
				if Skin.pack then
					notify("Base pack loaded", T.Good)
				end
			end)
			task.defer(rebuild)
		end
	end)
	_G.__SalemSkinLabel = currentLbl
end

do

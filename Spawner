	for _, p in ipairs(pods:GetChildren()) do
		local key = tonumber(p.Name)
		local base = p:FindFirstChild("Base")
		local sp = base and base:FindFirstChild("Spawn")
		if key and sp then
			table.insert(list, { key = key, spawn = sp, att = sp:FindFirstChild("PromptAttachment"), folder = p })
		end
	end
	table.sort(list, function(a, b)
		return a.key < b.key
	end)
	return list
end


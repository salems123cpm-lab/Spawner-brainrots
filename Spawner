local function calcGen(name, mutation, traits)
	local info = animalByName[name]
	local base = info and info.gen or 0
	if base <= 0 then
		return 0
	end
	local mult = 1
	if mutation and mutation ~= "None" then
		mult += mutMod(mutation)
	end
	local sleepy = false
	for _, t in ipairs(traits or {}) do
		if t == "Sleepy" then
			sleepy = true
		else
			mult += traitMod(t)
		end
	end
	local g = base * mult
	if sleepy then
		g *= 0.5
	end
	return math.floor(g)
end

local function fmt(n)
	n = tonumber(n) or 0
	for _, u in ipairs({ { 1e18, "Qi" }, { 1e15, "Qa" }, { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e3, "K" } }) do
		if n >= u[1] then
			local v = string.format("%.1f", n / u[1]):gsub("%.0$", "")
			return v .. u[2]
		end
	end
	return tostring(math.floor(n))
end

local lockedPlot
local function isOwnedPlot(plot)
	local sign = plot:FindFirstChild("PlotSign")
	local yb = sign and sign:FindFirstChild("YourBase", true)
	if yb and yb:IsA("BillboardGui") and yb.Enabled then
		return true
	end
	for _, a in ipairs({ "OwnerUserId", "UserId", "PlayerUserId", "OwnerId" }) do
		if tonumber(plot:GetAttribute(a)) == LP.UserId then
			return true
		end
	end
	for _, a in ipairs({ "Owner", "OwnerName", "PlayerName" }) do
		local v = plot:GetAttribute(a)
		if v == LP.Name or v == LP.DisplayName then
			return true
		end
	end
	local owner = plot:FindFirstChild("Owner", true)
	if owner then
		if owner:IsA("ObjectValue") and owner.Value == LP then
			return true
		end
		if owner:IsA("StringValue") and owner.Value == LP.Name then
			return true
		end
		if (owner:IsA("IntValue") or owner:IsA("NumberValue")) and owner.Value == LP.UserId then
			return true
		end
	end
	return false
end

local function getPlot()
	if lockedPlot and lockedPlot.Parent and isOwnedPlot(lockedPlot) then
		return lockedPlot
	end
	lockedPlot = nil
	local plots = workspace:FindFirstChild("Plots")
	if not plots then
		return nil
	end
	for _, p in ipairs(plots:GetChildren()) do
		if isOwnedPlot(p) then
			lockedPlot = p
			return p
		end
	end
	return nil
end

local function getPodiums()

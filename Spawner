local function refreshSlot(key, pods)
	local pod = podium(key, pods)
	if not pod or not pod.att then
		return
	end
	if slotConns[key] then
		for _, c in ipairs(slotConns[key]) do
			c:Disconnect()
		end
	end
	slotConns[key] = {}
	local e = slotMap[key]
	local server = serverOccupied(key)
	if server and not e then
		return 
	end
	if not e and not carrying then
		if touched[key] then
			for _, p in ipairs(pod.att:GetChildren()) do
				if p:IsA("ProximityPrompt") then
					setPrompt(p, "Interact", "", "None", false)
				end
			end
			touched[key] = nil
		end
		return
	end
	touched[key] = true
	for _, p in ipairs(pod.att:GetChildren()) do
		if p:IsA("ProximityPrompt") then
			if p.KeyboardKeyCode == Enum.KeyCode.E then
				if carrying then
					setPrompt(p, "Place", e and e.name or "", "None", true)
					table.insert(
						slotConns[key],
						p.Triggered:Connect(function()
							placeAt(key)
						end)
					)
				else
					setPrompt(p, "Grab", e.name, "Grab", true)
					table.insert(
						slotConns[key],
						p.Triggered:Connect(function()
							if not carrying and slotMap[key] == e then
								startCarry(e)
							end
						end)
					)
				end
			elseif p.KeyboardKeyCode == Enum.KeyCode.F then
				if e and not carrying then
					setPrompt(p, sellText(e), e.name, "Sell", true)
					table.insert(
						slotConns[key],
						p.Triggered:Connect(function()
							if slotMap[key] == e then
								removeEntry(e)
							end
						end)
					)
				else
					setPrompt(p, "Interact", "", "None", false)
				end
			end
		end
	end
end

local function refreshAll()
	local pods = getPodiums()
	for _, p in ipairs(pods) do
		refreshSlot(p.key, pods)
	end
end


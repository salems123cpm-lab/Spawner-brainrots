local function applyMutation(model, name, mut)
	if not mut or mut == "None" then
		return
	end
	if SharedAnimals then
		local ok = pcall(function()
			SharedAnimals:ApplyMutation(model, name, mut)
		end)
		if ok then
			return
		end
	end
	local md = Data.Mutations[mut]
	local palette = type(md) == "table" and md.Palettes and md.Palettes[1]
	if mut == "Rainbow" then
		model:AddTag("RainbowModel")
		return
	end
	if not palette then
		return
	end
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") and not p:GetAttribute("IgnoreColor") then
			pcall(function()
				local idx = tonumber(p:GetAttribute(mut .. "Color") or p:GetAttribute("Color") or 1) or 1
				local col = palette[math.clamp(idx, 1, #palette)]
				local sa = p:FindFirstChildOfClass("SurfaceAppearance")
				if sa then
					sa.Color = col
				else
					p.Color = col
				end
			end)
		end
	end
end

local function applyTraits(model, name, traits)
	if #traits == 0 then
		return
	end
	if SharedAnimals then
		local ok = pcall(function()
			SharedAnimals:ApplyTraits(model, name, traits)
		end)
		if ok then
			return
		end
	end
	local models = RS:FindFirstChild("Models")
	local tap = models and models:FindFirstChild("TraitsPerAnimal")
	local generic = models and models:FindFirstChild("Traits")
	for _, t in ipairs(traits) do
		pcall(function()
			local src = (tap and tap:FindFirstChild(t) and tap[t]:FindFirstChild(name))
				or (generic and generic:FindFirstChild(t))
			if not src then
				return
			end
			local clone = src:Clone()
			clone.Name = "_Trait." .. t
			for _, att in ipairs(clone:GetDescendants()) do
				if att:IsA("Attachment") then
					local target = model:FindFirstChild(att.Name, true)
					if target and target:IsA("Attachment") then
						local rc = Instance.new("RigidConstraint")
						rc.Attachment0 = att
						rc.Attachment1 = target
						rc.Parent = att.Parent
					end
				end
			end
			clone.Parent = model
		end)
	end
end

local function playIdle(model, name)
	task.spawn(function()

	if e.cashPart then
		pcall(function()
			e.cashPart:Destroy()
		end)
		e.cashPart = nil
	end
end

local function buildCashpad(e, pods)
	destroyCashpad(e)
	local pod = podium(e.slot, pods)
	local claim = pod and pod.folder:FindFirstChild("Claim")
	local main = claim and claim:FindFirstChild("Main")
	local hit = claim and claim:FindFirstChild("Hitbox")
	local foc = RS:FindFirstChild("Controllers") and RS.Controllers:FindFirstChild("FastOverheadController")
	local tmpl = foc and foc:FindFirstChild("CashPad")
	if not (main and tmpl) then
		return
	end
	local part = Instance.new("Part")
	part.Name = "SalemCashPad"
	part.Size = Vector3.new(5, 3, 0.1)
	part.Transparency = 1
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Parent = workspace
	local gui = tmpl:Clone()
	gui.Adornee = part
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.MaxDistance = 72
	gui.Parent = part
	local amtL = gui:FindFirstChild("CollectAmount", true)
	local colL = gui:FindFirstChild("Collect", true)
	local offL = gui:FindFirstChild("Offline", true)
	if colL then
		colL.Visible = true
	end
	local function showOffline()
		if not offL then
			return
		end
		if (e.offline or 0) > 0 then
			offL.RichText = true
			offL.Text = '(Offline Cash: <font color="#39FF14">$' .. fmt(e.offline) .. "</font>)"
			offL.Visible = true
		else
			offL.Visible = false
		end
	end
	showOffline()
	if amtL then
		amtL.Text = "$" .. fmt(e.cash or 0)
	end
	e.cashPart = part
	local lastTick, lastDisplay, wasOn = tick(), tick(), false
	local mult, multAt = plotMultiplier(), tick()
	e.cashConn = RunService.Heartbeat:Connect(function()
		local now = tick()
		local dt = now - lastTick
		lastTick = now
		if now - multAt > 2 then
			mult, multAt = plotMultiplier(), now
		end
		e.cash = (e.cash or 0) + e.gen * mult * dt
		local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
		if hrp and hit then
			local on = (hrp.Position - hit.Position).Magnitude < 5
			if on and not wasOn then
				e.cash, e.offline = 0, 0
				lastDisplay = now
				if amtL then
					amtL.Text = "$0"
				end
				showOffline()
				playSfx("Sounds.Sfx.Cashout")
			end
			wasOn = on
		end
		if now - lastDisplay >= 1 then
			lastDisplay = now
			if amtL then
				amtL.Text = "$" .. fmt(e.cash)
			end
		end
		local cam = workspace.CurrentCamera
		local pos = main.Position + Vector3.new(0, 2.41, 0)
		part.CFrame = CFrame.lookAt(pos, pos - cam.CFrame.LookVector)
		local d = (cam.CFrame.Position - pos).Magnitude
		gui.CanvasSize = d < 40 and Vector2.new(200, 120) or d < 72 and Vector2.new(100, 60) or Vector2.new(0, 0)
	end)
end


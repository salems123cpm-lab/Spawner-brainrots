	gui.Parent = part

	local info = animalByName[entry.name]
	local function lbl(n)
		local l = gui:FindFirstChild(n)
		return (l and l:IsA("TextLabel")) and l or nil
	end
	local dn = lbl("DisplayName")
	if dn then
		dn.Text = entry.name
	end
	local rar = lbl("Rarity")
	if rar then
		local r = info and info.rarity or "Unknown"
		rar.Text = r
		rar.TextColor3 = rarityColor(r)
		local rd = Data.Rarities[r]
		if Gradients and type(rd) == "table" and rd.GradientPreset then
			pcall(function()
				rar.TextColor3 = Color3.new(1, 1, 1)
				Gradients.apply(rar, rd.GradientPreset)
			end)
		end
	end
	local mutL = lbl("Mutation")
	if mutL then
		local md = Data.Mutations[entry.mutation]
		if entry.mutation ~= "None" and type(md) == "table" then
			if md.UseRichText then
				mutL.RichText = true
				mutL.Text = md.DisplayWithRichText or md.DisplayText or entry.mutation
			else
				mutL.Text = md.DisplayText or entry.mutation
			end
			mutL.TextColor3 = md.MainColor or Color3.new(1, 1, 1)
			if Gradients and md.GradientPreset then
				pcall(function()
					Gradients.apply(mutL, md.GradientPreset)
				end)
			end
			mutL.Visible = true
		else
			mutL.Visible = false
		end
	end
	local genL = lbl("Generation")
	if genL then
		genL.Visible = entry.gen > 0
		genL.Text = "$" .. fmt(entry.gen) .. "/s"
		genL.TextColor3 = Color3.fromRGB(255, 247, 0)
	end
	local priceL = lbl("Price")
	if priceL then
		local price = info and info.price or 0
		priceL.Visible = price > 0
		priceL.Text = "$" .. fmt(price)
		priceL.TextColor3 = Color3.fromRGB(115, 255, 0)
	end
	local stolen = gui:FindFirstChild("Stolen")
	if stolen then
		stolen.Visible = false
	end
	local tf = gui:FindFirstChild("Traits")
	local tt = tf and tf:FindFirstChild("Template")
	if tf and tt then
		tf.ClipsDescendants = false
		local n = 0
		for _, t in ipairs(entry.traits) do
			local ic = traitIcon(t)
			if ic then
				local img = tt:Clone()
				img.Image = ic
				img.Visible = true
				img.Parent = tf
				n += 1
			end
		end
		tf.Visible = n > 0
	end

	local yOff = entry.height * 0.75 * (info and info.yMod or 1) + 2.5
	entry.overhead = part
	entry.ohGui = gui
	entry.ohConn = RunService.RenderStepped:Connect(function()
		if not entry.model.Parent then
			return
		end
		local cam = workspace.CurrentCamera
		local pos = entry.model:GetPivot().Position + Vector3.new(0, yOff, 0)
		part.CFrame = CFrame.lookAt(pos, pos - cam.CFrame.LookVector)
	end)
end

local function plotMultiplier()
	local mult = 1
	pcall(function()
		local m = getPlot():FindFirstChild("Multiplier")
		local amt = m and m:FindFirstChild("Amount", true)
		if amt and amt:IsA("TextLabel") then
			mult = tonumber(amt.Text:match("([%d%.]+)")) or 1
		end
	end)
	return mult
end


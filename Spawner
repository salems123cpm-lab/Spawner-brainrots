		TextSize = 13,
		TextColor3 = T.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = kr,
	})
	new("TextLabel", {
		Size = UDim2.new(1, -140, 0, 14),
		Position = UDim2.fromOffset(14, 30),
		BackgroundTransparency = 1,
		Text = "Click, then press a key (Esc cancels)",
		Font = Enum.Font.GothamMedium,
		TextSize = 10,
		TextColor3 = T.Sub,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = kr,

local function refreshScale()
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	local vp = cam.ViewportSize
	if TOUCH then
		baseScale = math.clamp(math.min(vp.X, vp.Y) / 520, 0.6, 0.85)
	else
		baseScale = math.clamp(math.min(vp.X / (MAX_W + 40), vp.Y / (MAX_H + 60)), 0.6, 0.9)
	end
	WIN_W = math.floor(math.min(MAX_W, (vp.X - 24) / baseScale))
	WIN_H = math.floor(math.min(MAX_H, (vp.Y - 24) / baseScale))
	holder.Size = UDim2.fromOffset(WIN_W, minimized and TITLE_H or WIN_H)
	applyScale()
end

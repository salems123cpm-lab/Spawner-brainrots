function Skin.syncSelector()
	local btn = Skin.selectorButton()
	if not btn then
		return
	end
	local label = btn:FindFirstChild("Text")
	label = (label and label:IsA("TextLabel")) and label or btn:FindFirstChildWhichIsA("TextLabel", true)
	local st = btn:FindFirstChildOfClass("UIStroke")
	if Skin.selOrig == nil or Skin.selOrig.btn ~= btn then
		Skin.selOrig = {
			btn = btn,
			bg = btn.BackgroundColor3,
			stroke = st and st.Color,
			text = label and label.Text,
		}
	end
	local o = Skin.selOrig
	if Skin.name then
		local c
		for key, col in pairs(Skin.COLORS) do
			if Skin.name:lower():find(key:lower(), 1, true) then
				c = col
			end
		end
		if c then
			btn.BackgroundColor3 = c
			if st then
				st.Color = c:Lerp(Color3.new(0, 0, 0), 0.15)
			end
		end
		if label and label.Text ~= Skin.name then
			label.Text = Skin.name
		end
	else
		btn.BackgroundColor3 = o.bg
		if st and o.stroke then
			st.Color = o.stroke
		end
		if label and o.text then
			label.Text = o.text
		end
		Skin.selOrig = nil
	end
end


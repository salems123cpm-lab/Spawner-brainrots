local animalList, animalByName = {}, {}
do
	local seen = {}
	local function add(name, rarity, gen, price, yMod)
		if seen[name] then
			return
		end
		seen[name] = true
		local b = BAKED.ANIMAL_DATA[name]
		if (not gen or gen <= 0) and b then
			gen = b.gen
		end
		if (not price or price <= 0) and b then
			price = b.price
		end
		if not rarity or rarity == "Unknown" then
			rarity = bakedRarity[name] or "Unknown"
		end
		table.insert(animalList, { name = name, rarity = rarity, gen = gen or 0, price = price or 0, yMod = yMod or 1 })
	end
	for name, info in pairs(Data.Animals) do
		if type(name) == "string" and type(info) == "table" then
			add(name, info.Rarity, tonumber(info.Generation), tonumber(info.Price), tonumber(info.OverheadYOffsetModifier))
		end
	end
	for name in pairs(BAKED.ANIMAL_DATA) do
		add(name)
	end
	for n in pairs(bakedRarity) do
		add(n)
	end
	local folder = RS:FindFirstChild("Models") and RS.Models:FindFirstChild("Animals")
	if folder then
		for _, m in ipairs(folder:GetChildren()) do
			add(m.Name)
		end
	end
	table.sort(animalList, function(a, b)
		local ra, rb = RARITY_ORDER[a.rarity] or 99, RARITY_ORDER[b.rarity] or 99
		if ra ~= rb then
			return ra < rb
		end
		if a.gen ~= b.gen then
			return a.gen > b.gen
		end
		return a.name < b.name
	end)
	for _, e in ipairs(animalList) do
		animalByName[e.name] = e
	end
end


local pages, tabButtons, currentTab = {}, {}, nil
local TAB_NAMES = { "Spawn", "Base", "Settings" }
local function setTab(name)
	if currentTab == name then
		return
	end
	local idx = table.find(TAB_NAMES, name)
	tween(indicator, 0.35, { Position = UDim2.new((idx - 1) / 3, 3, 0, 3) })
	for n, b in pairs(tabButtons) do
		tween(b, 0.25, { TextColor3 = n == name and Color3.new(1, 1, 1) or T.Sub })
	end
	local prevIdx = currentTab and table.find(TAB_NAMES, currentTab) or idx
	local dir = idx >= prevIdx and 1 or -1
	local prev = currentTab and pages[currentTab]
	if prev then
		local pv = prev
		tween(pv, 0.25, { Position = UDim2.new(-0.35 * dir, 0, 0, 0) }).Completed:Connect(function()
			if pages[currentTab] ~= pv then
				pv.Visible = false
			end
		end)
	end
	local pg = pages[name]
	pg.Position = UDim2.new(0.35 * dir, 0, 0, 0)
	pg.Visible = true
	tween(pg, 0.35, { Position = UDim2.new() })
	local s = tabButtons[name]:FindFirstChildOfClass("UIScale") or new("UIScale", { Parent = tabButtons[name] })
	s.Scale = 0.85
	tween(s, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	currentTab = name
end

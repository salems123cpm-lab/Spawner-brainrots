if settings.autoRestore and type(saved) == "table" and type(saved.spawns) == "table" and #saved.spawns > 0 then
	task.spawn(function()
		local deadline = tick() + 30
		local function ready()
			for _, p in ipairs(getPodiums()) do
				if p.att and #p.att:GetChildren() > 0 then
					return true
				end
			end
			return false
		end
		while alive() and not ready() and tick() < deadline do
			task.wait(0.25)
		end
		local n = 0
		for _, s in ipairs(saved.spawns) do
			if type(s) == "table" and type(s.name) == "string" then
				local traits = type(s.traits) == "table" and s.traits or {}
				local gen = calcGen(s.name, s.mutation or "None", traits)
				local away = math.clamp(os.time() - (tonumber(saved.savedAt) or os.time()), 0, 86400)
				local offline = gen * away
				local opts = { cash = (tonumber(s.cash) or 0) + offline, offline = offline }
				if spawnVisual(s.name, s.mutation or "None", traits, tonumber(s.slot), true, opts) then
					n += 1
				end
			end
		end
		if n > 0 then
			notify(("Restored %d visual%s"):format(n, n == 1 and "" or "s"), T.Good)
		end

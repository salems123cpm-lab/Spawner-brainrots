end

local function protected(obj, plot)
	local p = obj.Parent
	while p and p ~= plot do
		if NEVER_HIDE[p.Name] or p:FindFirstChildOfClass("Humanoid") then
			return true
		end
		p = p.Parent
	end
	return false
end

local function hidePart(obj, plot)
	if obj:IsA("BasePart") and not NEVER_HIDE[obj.Name] and obj.Transparency < 1 and not protected(obj, plot) then
		Skin.hidden[obj] = obj.LocalTransparencyModifier
		obj.LocalTransparencyModifier = 1
	end
end

function Skin.selectorButton()
	local pg = LP:FindFirstChild("PlayerGui")
	local scroll = pg and pg:FindFirstChild("Settings")
	for _, n in ipairs({ "Settings", "Content", "ScrollingFrame" }) do
		scroll = scroll and scroll:FindFirstChild(n)

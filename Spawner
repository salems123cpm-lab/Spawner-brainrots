local function setMinimized(v)
	if v == minimized then
		return
	end
	minimized = v
	minBtn.Text = v and "+" or "–"
	local shift = (WIN_H - TITLE_H) / 2 * scaleObj.Scale
	local p = holder.Position
	tween(holder, 0.4, {
		Size = UDim2.fromOffset(WIN_W, v and TITLE_H or WIN_H),
		Position = UDim2.new(p.X.Scale, p.X.Offset, p.Y.Scale, p.Y.Offset + (v and -shift or shift)),
	})
	local s = minBtn:FindFirstChildOfClass("UIScale")
	if s then
		s.Scale = 0.8
		tween(s, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	end
end

local function setOpen(v)
	if v == isOpen then
		return
	end
	isOpen = v
	if v then
		holder.Visible = true
		pop.Value = 0.85
		tween(pop, 0.4, { Value = 1 }, Enum.EasingStyle.Back)
		if reopenBtn then
			tween(reopenBtn, 0.2, { Size = UDim2.fromOffset(0, 0) })
		end
	else
		local tw = tween(pop, 0.22, { Value = 0.85 }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
		tw.Completed:Connect(function()
			if not isOpen then
				holder.Visible = false
			end
		end)
		if reopenBtn then
			tween(reopenBtn, 0.35, { Size = UDim2.fromOffset(52, 52) }, Enum.EasingStyle.Back)
		end
		notify(TOUCH and "Hidden — tap the SALEM button to reopen" or ("Hidden — press %s to reopen"):format(settings.toggleKey), T.Accent2)
	end
end


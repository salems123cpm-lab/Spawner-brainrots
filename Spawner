local function saveNow()
	if not hasFiles then
		return
	end
	local list = {}
	for _, e in ipairs(entries) do
		table.insert(list, {
			name = e.name,
			mutation = e.mutation,
			traits = e.traits,
			slot = e.slot,
			cash = math.floor(e.cash or 0),
		})
	end
	settings.baseSkin = Skin.name
	pcall(function()
		writefile(
			SAVE_FILE,
			HttpService:JSONEncode({ version = 2, settings = settings, spawns = list, savedAt = os.time() })
		)
	end)
end
local savePending = false
scheduleSave = function()
	if savePending then
		return
	end
	savePending = true
	task.delay(0.5, function()
		savePending = false
		saveNow()
	end)
end

local function new(class, props, children)
	local o = Instance.new(class)
	local parent
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			o[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = o
	end
	if parent then
		o.Parent = parent
	end
	return o
end

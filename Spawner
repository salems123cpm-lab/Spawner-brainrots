		corner(trackF, 12)
		local tst = stroke(trackF, T.Stroke)
		local fill = new("Frame", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = 1,
			Parent = trackF,
		})
		corner(fill, 12)
		accentGradient(fill, 0)
		local knob = new("Frame", {
			Size = UDim2.fromOffset(18, 18),
			Position = UDim2.new(0, 3, 0.5, -9),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 2,
			Parent = trackF,
		})
		corner(knob, 9)
		local function render(instant)
			local on = settings[key]
			local t = instant and 0 or 0.25
			tween(knob, t, { Position = on and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9) })
			tween(fill, t, { BackgroundTransparency = on and 0 or 1 })
			tween(tst, t, { Transparency = on and 1 or 0 })

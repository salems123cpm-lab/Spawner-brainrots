			LP.Character:FindFirstChildOfClass("Humanoid").WalkSpeed = carrySpeed
		end)
		carrySpeed = nil
	end
	if carrying and carrying.ohGui then
		carrying.ohGui.Enabled = true
	end
end

local function makeGhost(e, pod)
	local ok, g = pcall(function()
		return e.model:Clone()
	end)
	if not ok or not g then
		return nil
	end
	g.Name = "SalemCarryGhost"
	local root = g.PrimaryPart or g:FindFirstChild("RootPart")
	for _, d in ipairs(g:GetDescendants()) do
		if d:IsA("BasePart") then
			local vfx = d.Name == "VfxInstance" or d.Name == "FakeRootPart" or (d.Parent and d.Parent.Name == "VfxInstance")
			if d == root or d.Name == "RootPart" or d.Name == "HumanoidRootPart" or vfx then
				d.Transparency = 1
			else
				d.Transparency = math.min(d.Transparency + 0.6, 0.85)
			end
			d.CastShadow = false
			d.Anchored = true
		elseif d:IsA("Attachment") and d.Name == "OVERHEAD_ATTACHMENT" then
			d:Destroy()
		end
	end
	g:PivotTo(pod.spawn:GetPivot())
	g.Parent = workspace.CurrentCamera
	return g
end

startCarry = function(e)
	local hrp = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	carrying, carryOrigin = e, e.slot
	slotMap[e.slot] = nil
	if e.ohGui then
		e.ohGui.Enabled = false 
	end
	local originPod = podium(e.slot)
	if originPod then
		carryGhost = makeGhost(e, originPod)
	end
	pcall(function()
		local hum = LP.Character:FindFirstChildOfClass("Humanoid")
		carrySpeed = hum.WalkSpeed
		hum.WalkSpeed = 20.1
		hum:UnequipTools()
		local anim = RS.Animations.Player:FindFirstChild("Carry")
		local animator = hum:FindFirstChildOfClass("Animator")
		if anim and animator then
			carryTrack = animator:LoadAnimation(anim)
			carryTrack.Looped = true
			carryTrack:Play()
			carryTrack:AdjustSpeed(1.5)
		end
	end)
	carryConn = RunService.Heartbeat:Connect(function()
		if not e.model.Parent or not hrp.Parent then
			return
		end
		e.model:PivotTo(hrp.CFrame * CFrame.new(0, 0.5, -4))
	end)
	refreshAll()
end

local function returnCarried()
	local e = carrying
	if not e then
		return
	end
	endCarryVisuals()
	carrying = nil
	local pods = getPodiums()
	local key = carryOrigin
	if slotMap[key] or serverOccupied(key) then
		key = nil
		for _, p in ipairs(pods) do
			if not slotMap[p.key] and not serverOccupied(p.key) then
				key = p.key
				break
			end
		end
	end
	carryOrigin = nil
	local pod = key and podium(key, pods)
	if pod then
		local moved = e.slot ~= key
		e.slot = key
		slotMap[key] = e
		e.model:PivotTo(pod.spawn:GetPivot())
		if moved then
			buildCashpad(e, pods)
		end
	else
		removeEntry(e)
	end
	refreshAll()
end

placeAt = function(key)
	local e = carrying
	if not e then
		return
	end
	local pods = getPodiums()
	local pod = podium(key, pods)
	if not pod then
		return
	end
	endCarryVisuals()
	carrying = nil
	local other = slotMap[key]
	if other and other ~= e and carryOrigin then
		local originPod = podium(carryOrigin, pods)
		other.slot = carryOrigin
		slotMap[carryOrigin] = other
		if originPod then
			other.model:PivotTo(originPod.spawn:GetPivot())
		end
		buildCashpad(other, pods)
	end
	carryOrigin = nil
	local moved = e.slot ~= key
	e.slot = key
	slotMap[key] = e
	e.model:PivotTo(pod.spawn:GetPivot())
	if moved then
		buildCashpad(e, pods)
	end
	playSfx("Sounds.Sfx.Place")
	refreshAll()
	scheduleSave()
end

removeEntry = function(e, skipSave)
	if carrying == e then
		endCarryVisuals()
		carrying, carryOrigin = nil, nil
	end
	if e.ohConn then
		e.ohConn:Disconnect()
	end
	destroyCashpad(e)
	if e.overhead then
		pcall(function()
			e.overhead:Destroy()
		end)
	end
	pcall(function()
		e.model:Destroy()
	end)
	if slotMap[e.slot] == e then
		slotMap[e.slot] = nil
	end
	for i, x in ipairs(entries) do
		if x == e then
			table.remove(entries, i)
			break
		end
	end
	refreshAll()
	if onEntriesChanged then
		onEntriesChanged()
	end
	if not skipSave then
		scheduleSave()
	end
	if updateCount then
		updateCount()
	end
end

local function freeSlot(preferred, pods)
	local cap = math.min(10 + rebirths(), #pods)
	local function isFree(key)
		return not slotMap[key] and not serverOccupied(key) and carryOrigin ~= key
	end
	if preferred then
		for i = 1, cap do
			if pods[i].key == preferred and isFree(preferred) then
				return pods[i]
			end
		end
	end
	for i = 1, cap do
		if isFree(pods[i].key) then
			return pods[i]
		end
	end
	return nil
end

local function spawnVisual(name, mutation, traits, preferredSlot, skipSave, opts)
	if not getPlot() then
		return false, "Couldn't find your plot"
	end
	local pods = getPodiums()
	local pod = freeSlot(preferredSlot, pods)
	if not pod then
		return false, "All podium slots are full"
	end
	local model = acquireModel(name)
	if not model then
		return false, "Model not found: " .. name
	end
	local root = model.PrimaryPart or model:FindFirstChild("RootPart")
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.CanCollide = false
			p.CanQuery = false
			p.CanTouch = false
			p.Massless = true
			if not root then
				p.Anchored = true
			end
		end
	end
	if root then
		root.Anchored = true
	end
	model:SetAttribute("SalemVisual", true)
	model.Parent = workspace
	model:PivotTo(pod.spawn:GetPivot())
	local height = model:GetExtentsSize().Y
	applyMutation(model, name, mutation)
	applyTraits(model, name, traits)
	playIdle(model, name)

	local e = {
		name = name,
		mutation = mutation,
		traits = traits,
		slot = pod.key,
		model = model,
		height = height,
		gen = calcGen(name, mutation, traits),
		cash = opts and tonumber(opts.cash) or 0,
		offline = opts and tonumber(opts.offline) or 0,
	}
	table.insert(entries, e)
	slotMap[pod.key] = e
	pcall(buildOverhead, e)
	pcall(buildCashpad, e, pods)
	refreshSlot(pod.key, pods)
	if onSpawned then
		task.spawn(onSpawned, e)
	end
	if not skipSave then
		scheduleSave()
	end
	if updateCount then
		updateCount()
	end
	return true
end

local function clearAll()
	for i = #entries, 1, -1 do
		removeEntry(entries[i], true)
	end
	scheduleSave()
end


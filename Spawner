function Skin.sanitize(root)
	local removed = 0
	for _, d in ipairs(root:GetDescendants()) do
		if d:IsA("LuaSourceContainer") then
			pcall(function()
				d:Destroy()
			end)
			removed += 1
		end
	end
	return removed
end

function Skin.loadPack()
	if Skin.pack then
		return Skin.pack
	end
	if Skin.packLoading then
		while Skin.packLoading do
			task.wait(0.1)
		end
		return Skin.pack
	end
	Skin.packLoading = true
	local ok, err = pcall(function()
		if typeof(isfile) ~= "function" or typeof(writefile) ~= "function" then
			error("your executor can't save files")
		end
		if not isfile(Skin.PACK_FILE) then
			local data = game:HttpGet(Skin.PACK_URL)
			if type(data) ~= "string" or #data < 100 or not data:find("<roblox", 1, true) then
				error("download failed")
			end
			writefile(Skin.PACK_FILE, data)
		end
		local objs
		local getters = {}
		if typeof(getcustomasset) == "function" then
			table.insert(getters, getcustomasset)
		end
		if typeof(getsynasset) == "function" then
			table.insert(getters, getsynasset)
		end
		for _, getter in ipairs(getters) do
			if not objs or #objs == 0 then
				local okA, url = pcall(getter, Skin.PACK_FILE)
				if okA and type(url) == "string" then
					pcall(function()
						objs = game:GetObjects(url)
					end)
				end
			end
		end
		if not objs or #objs == 0 then
			error("your executor can't load model files")
		end
		local holder = Instance.new("Folder")
		holder.Name = "SalemBasePack"
		for _, o in ipairs(objs) do
			if typeof(o) == "Instance" then
				if o:IsA("LuaSourceContainer") then
					o:Destroy()
				else
					Skin.sanitize(o)
					o.Parent = holder
				end
			end
		end
		Skin.sanitize(holder)
		Skin.pack = holder 
	end)
	Skin.packLoading = false
	if not ok then
		Skin.packError = tostring(err):gsub("^.-:%d+: ", "")
	end
	return Skin.pack
end

local function findSkins()
	local byName, names = {}, {}
	local function scan(root)
		for _, d in ipairs(root:GetDescendants()) do
			if
				(d:IsA("Model") or d:IsA("Folder"))
				and not byName[d.Name]
				and (d:FindFirstChild("FirstFloor") or d:FindFirstChild("SecondFloor") or d:FindFirstChild("ThirdFloor"))
			then
				byName[d.Name] = d
				table.insert(names, d.Name)
			end
		end
	end
	if Skin.pack then
		scan(Skin.pack)
	end
	scan(RS)
	table.sort(names, function(a, b)
		return a:lower() < b:lower()
	end)
	return names, byName
end

local function applySkin(name)
	local _, byName = findSkins()
	local entry = byName[name]
	if not entry and not Skin.pack then
		Skin.loadPack()
		_, byName = findSkins()
		entry = byName[name]
	end
	if not entry then
		return false, Skin.packError and ("Base pack: " .. Skin.packError) or ("Base not found: " .. name)
	end
	local plot = getPlot()
	if not plot then
		return false, "Couldn't find your plot"
	end
	local plotRoot = plot:FindFirstChild("MainRoot") or plot:FindFirstChild("Spawn")
	if not plotRoot then
		return false, "Plot root not found"
	end
	local r = rebirths()
	local floorName = r >= 10 and "ThirdFloor" or r >= 2 and "SecondFloor" or "FirstFloor"
	local floor = entry:FindFirstChild(floorName)
		or entry:FindFirstChild("ThirdFloor")
		or entry:FindFirstChild("SecondFloor")
		or entry:FindFirstChild("FirstFloor")
	clearSkin()

	local clone = floor:Clone()
	clone.Name = "SalemBaseSkin"
	local hasSkinSign = clone:FindFirstChild("SkinPlotSign", true) ~= nil
	for _, d in ipairs(clone:GetDescendants()) do
		local n = d.Name
		if
			d:IsA("ProximityPrompt")
			or d:IsA("PathfindingModifier")
			or NEVER_HIDE[n]
			or n == "YourBase"
			or (n == "PlotSign" and hasSkinSign)
		then
			pcall(function()
				d:Destroy()
			end)
		end
	end
	for _, d in ipairs(clone:GetDescendants()) do
		if d:IsA("BasePart") then
			d.Anchored = true
			d.CanCollide = false
			d.CanQuery = false
			d.CanTouch = false
		elseif d:IsA("TextLabel") then
			pcall(function()
				d.Text = d.Text:gsub("{playerName}", LP.DisplayName)
			end)
		end
	end
	clone.Parent = workspace

	local skinRoot = clone:FindFirstChild("Root", true)
	local refCF
	if skinRoot and skinRoot:IsA("BasePart") then
		refCF = skinRoot.CFrame
	else
		local minX, minZ, maxX, maxZ, groundY = math.huge, math.huge, -math.huge, -math.huge, math.huge
		for _, p in ipairs(clone:GetDescendants()) do
			if p:IsA("BasePart") then
				local pos, half = p.Position, p.Size / 2
				minX, minZ = math.min(minX, pos.X - half.X), math.min(minZ, pos.Z - half.Z)
				maxX, maxZ = math.max(maxX, pos.X + half.X), math.max(maxZ, pos.Z + half.Z)
				if p.Size.X * p.Size.Z > 100 then
					groundY = math.min(groundY, pos.Y - p.Size.Y * 0.15)
				end
			end
		end
		if minX ~= math.huge then
			refCF = CFrame.new((minX + maxX) / 2, groundY == math.huge and 0 or groundY, (minZ + maxZ) / 2)
		end
	end
	if refCF then
		local offset = plotRoot.CFrame * refCF:Inverse()
		for _, p in ipairs(clone:GetDescendants()) do
			if p:IsA("BasePart") then
				p.CFrame = offset * p.CFrame
			end
		end
		if skinRoot then
			skinRoot:Destroy()
		end
	end

	for _, d in ipairs(plot:GetDescendants()) do
		hidePart(d, plot)
	end
	Skin.conn = plot.DescendantAdded:Connect(function(d)
		task.defer(hidePart, d, plot)
	end)
	Skin.clone, Skin.name = clone, name
	pcall(Skin.syncSelector)
	return true
end

local SKIN_REQUIREMENT = {
	Skibidi = "Skibidi Toilet",
	Headless = "Headless Horseman",
	Meowl = "Meowl",
	Strawberry = "Strawberry Elephant",
	["John Pork"] = "John Pork",
}
local function skinRequirement(skinName)
	local low = skinName:lower()
	for key, brainrot in pairs(SKIN_REQUIREMENT) do
		if low:find(key:lower(), 1, true) then
			return brainrot
		end
	end
	return nil
end
local function skinForBrainrot(brainrot)
	Skin.loadPack()
	local names = findSkins()
	for _, n in ipairs(names) do
		if skinRequirement(n) == brainrot then
			return n
		end
	end
	return nil
end
local function ownsBrainrot(name)
	for _, e in ipairs(entries) do
		if e.name == name then
			return true
		end
	end
	local ok, found = pcall(function()
		local pods = syncChannel and syncChannel:Get("AnimalPodiums") or {}
		for _, v in pairs(pods) do
			if (type(v) == "table" and v.Index == name) or v == name then
				return true
			end
		end
		return false
	end)
	return ok and found or false
end

local autoSkinFor = nil 
onSpawned = function(e)
	if not settings.autoOgSkin then
		return
	end
	local req = nil
	for _, b in pairs(SKIN_REQUIREMENT) do
		if b == e.name then
			req = b
		end
	end
	if not req or (Skin.name and not autoSkinFor) then
		return 
	end
	local skin = skinForBrainrot(e.name)
	if not skin then
		if notify then
			notify(e.name .. " base isn't loaded in this server", T.Warn)
		end
		return
	end
	if Skin.name ~= skin and applySkin(skin) then
		autoSkinFor = e.name
		if _G.__SalemSkinLabel then
			_G.__SalemSkinLabel.Text = "Active: " .. skin
		end
		if notify then
			notify(skin .. " base unlocked", T.Good)
		end
		scheduleSave()
	end
end
onEntriesChanged = function()
	if autoSkinFor and not ownsBrainrot(autoSkinFor) then
		clearSkin()
		autoSkinFor = nil
		if _G.__SalemSkinLabel then
			_G.__SalemSkinLabel.Text = "Active: none"
		end
	end
end


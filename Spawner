local function tween(o, t, props, style, dir)
	local tw = TweenService:Create(
		o,
		TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function animate(btn, getBase, hoverColor)
	btn.AutoButtonColor = false
	local sc = new("UIScale", { Parent = btn })
	local function base()
		return type(getBase) == "function" and getBase() or getBase
	end
	btn.MouseEnter:Connect(function()
		tween(btn, 0.15, { BackgroundColor3 = hoverColor or base():Lerp(Color3.new(1, 1, 1), 0.1) })
	end)
	btn.MouseLeave:Connect(function()
		tween(btn, 0.2, { BackgroundColor3 = base() })
		tween(sc, 0.2, { Scale = 1 })
	end)
	btn.ClipsDescendants = true
	btn.MouseButton1Down:Connect(function()
		tween(sc, 0.08, { Scale = 0.95 })
		local r = Instance.new("Frame")
		r.AnchorPoint = Vector2.new(0.5, 0.5)
		r.Position = UDim2.fromScale(0.5, 0.5)
		r.SizeConstraint = Enum.SizeConstraint.RelativeXX
		r.Size = UDim2.fromScale(0, 0)
		r.BackgroundColor3 = Color3.new(1, 1, 1)
		r.BackgroundTransparency = 0.75
		r.BorderSizePixel = 0
		r.ZIndex = btn.ZIndex + 5
		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(1, 0)
		rc.Parent = r
		r.Parent = btn
		tween(r, 0.5, { Size = UDim2.fromScale(1.6, 1.6), BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
		task.delay(0.55, function()
			r:Destroy()
		end)
	end)
	btn.MouseButton1Up:Connect(function()
		tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
	return sc
end

